# Build output
build/
# Sanitizer and libFuzzer build dirs (build-asan/ubsan/tsan/fuzz).  build-fuzz
# also holds the generated seed corpora and any crash artifacts -- the corpora
# are copies of gitignored testdata/; only minimised crashers belong in the
# repo, under fuzz/regressions/.
build-asan/
build-ubsan/
build-tsan/
build-fuzz/
build-win/
dist-win/
*-setup.exe
_build/
.cache/
.claude/

# Meson private directory
.meson/

# Generated files
src/version.h
build_number.h
build_number.txt
database-arz.txt
debug.log

# Test data — contains game files, not redistributable
testdata/

# snapshot script
snap.sh

# External reference codebases — kept locally for study, not part of this project
reference/
TQVaultAE/
tqrespec/

# Internal planning and session notes
plans/

# Recordings and screenshots (keep screenshot1.png intentionally if desired)
*.mp4
*.mkv

# Ad-hoc debug captures dropped in the repo root for AI review
/windows.png
/linux.png
/skills*.png
skilltree_screenshots/
screenshots_testing/
*.log

# Editor and IDE
.vscode/
*.swp
*.swo
*~
.idea/

# Compiled objects left in-tree
*.o
# Ad-hoc `gcc -o src/utils/foo src/utils/foo.c` output.  Four such binaries
# were tracked by accident until 2026-08-13; everything in src/utils/ that is
# meant to ship is built by meson into the build dir instead.
src/utils/*
!src/utils/*.c
*.a
*.so

